    <Property Id="Group" Label="Group" Description="Display the node as a group" DataType="Microsoft.VisualStudio.GraphModel.GraphGroupStyle" />
    <Property Id="GroupLabel" DataType="System.String" />
    <Property Id="IncomingActionLabel" Label="IncomingActionLabel" Description="IncomingActionLabel" DataType="System.String" />
    <Property Id="IsContainment" DataType="System.Boolean" />
    <Property Id="IsEnabled" DataType="System.Boolean" />
    <Property Id="Label" Label="Label" Description="Displayable label of an Annotatable object" DataType="System.String" />
    <Property Id="OutgoingActionLabel" Label="OutgoingActionLabel" Description="OutgoingActionLabel" DataType="System.String" />
    <Property Id="TargetType" DataType="System.Type" />
    <Property Id="Value" DataType="System.String" />
    <Property Id="ValueLabel" DataType="System.String" />
    <Property Id="ZoomLevel" DataType="System.String" />
  </Properties>
  <Styles>
    <Style TargetType="Node" GroupLabel="Executable" ValueLabel="True">
      <Condition Expression="HasCategory('Executable')" />
      <Setter Property="Background" Value="#FF2D7DD2" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style TargetType="Node" GroupLabel="Core Contract" ValueLabel="True">
      <Condition Expression="HasCategory('CoreContract')" />
      <Setter Property="Background" Value="#FF27AE60" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="Runtime Library" ValueLabel="True">
      <Condition Expression="HasCategory('RuntimeLib')" />
      <Setter Property="Background" Value="#FF1ABC9C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="Domain / Pipeline" ValueLabel="True">
      <Condition Expression="HasCategory('DomainPipeline')" />
      <Setter Property="Background" Value="#FFE67E22" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="Persistence" ValueLabel="True">
      <Condition Expression="HasCategory('Persistence')" />
      <Setter Property="Background" Value="#FF8E44AD" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="Third-Party Fork" ValueLabel="True">
      <Condition Expression="HasCategory('ThirdParty')" />
      <Setter Property="Background" Value="#FF7F8C8D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="DDI Toolchain" ValueLabel="True">
      <Condition Expression="HasCategory('DDIToolchain')" />
      <Setter Property="Background" Value="#FF8D6E63" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="Server-Side" ValueLabel="True">
      <Condition Expression="HasCategory('ServerSide')" />
      <Setter Property="Background" Value="#FFE74C3C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Node" GroupLabel="Dependency Island" ValueLabel="True">
      <Condition Expression="HasCategory('IslandGroup')" />
      <Setter Property="Background" Value="#20000000" />
    </Style>
    <Style TargetType="Link" GroupLabel="Build-Time" ValueLabel="True">
      <Condition Expression="HasCategory('BuildTimeLink')" />
      <Setter Property="StrokeDashArray" Value="4 2" />
      <Setter Property="Stroke" Value="#FF8D6E63" />
    </Style>
    <Style TargetType="Node" GroupLabel="Flagged" ValueLabel="True">
      <Condition Expression="Description != ''" />
      <Setter Property="Stroke" Value="#FFE74C3C" />
      <Setter Property="StrokeThickness" Value="3" />
    </Style>
  </Styles>
</DirectedGraph>