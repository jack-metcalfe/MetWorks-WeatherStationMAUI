<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>MetWorks.DdiRegistry</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
	  <ProjectReference Include="..\MetWorks_Common\MetWorks_Common.csproj" />
	  <ProjectReference Include="..\MetWorks_Common_Logging\MetWorks_Common_Logging.csproj" />
	  <ProjectReference Include="..\MetWorks_Common_Settings\MetWorks_Common_Settings.csproj" />
	  <ProjectReference Include="..\MetWorks_Maui_Services\MetWorks_Maui_Services.csproj" />
	  <ProjectReference Include="..\MetWorks_Ingest_SQLite\MetWorks_Ingest_SQLite.csproj" />
	  <ProjectReference Include="..\MetWorks_Ingest_Transformer\MetWorks_Ingest_Transformer.csproj" />
	  <ProjectReference Include="..\MetWorks_InstanceIdentifier\MetWorks_InstanceIdentifier.csproj" />
	  <ProjectReference Include="..\MetWorks_Networking_Udp_Transformer\MetWorks_Networking_Udp_Transformer.csproj" />
	  <ProjectReference Include="..\RedStar_Amounts_WeatherExtensions\RedStar_Amounts_WeatherExtensions.csproj" />
	</ItemGroup>

	<PropertyGroup>
	  <DdiInputYaml>$(MSBuildThisFileDirectory)..\MetWorks_Apps_MAUI_Solutions_WeatherStationMaui_Docs\WeatherStationMaui.yaml</DdiInputYaml>
	  <DdiCodeGenToolProject>$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_CodeGenTool\MetWorks_DI_Declarative_CodeGenTool.csproj</DdiCodeGenToolProject>
	  <DdiCodeGenStampFile>$(IntermediateOutputPath)ddi.codegen.stamp</DdiCodeGenStampFile>
	  <DdiReferenceAssemblyListFile>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'ddi.reference-assemblies.txt'))</DdiReferenceAssemblyListFile>
	</PropertyGroup>

	<ItemGroup>
	  <DdiCodeGenToolSources Include="$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_CodeGenTool\**\*.cs" />
	  <DdiGeneratorSources Include="$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_Generator\**\*.cs" />
	  <DdiLoaderSources Include="$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_Loader\**\*.cs" />
	  <DdiResourcesSources Include="$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_Resources\**\*.cs" />
	  <DdiResourcesSources Include="$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_Resources\**\*.hbs" />
	</ItemGroup>

	<Target Name="GenerateDdiRegistryCode"
	        BeforeTargets="CoreCompile"
	        Condition="'$(DesignTimeBuild)' != 'true'"
	        Inputs="$(DdiInputYaml);@(DdiCodeGenToolSources);@(DdiGeneratorSources);@(DdiLoaderSources);@(DdiResourcesSources)"
	        Outputs="$(DdiCodeGenStampFile)">
	  <Message Importance="High" Text="DDI: generating registry code from $(DdiInputYaml)" />
	  <MSBuild Projects="$(DdiCodeGenToolProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
	  <PropertyGroup>
	    <DdiCodeGenToolExe>$(MSBuildThisFileDirectory)..\MetWorks_DI_Declarative_CodeGenTool\bin\$(Configuration)\net10.0\MetWorks_DI_Declarative_CodeGenTool.dll</DdiCodeGenToolExe>
	  </PropertyGroup>
	  <WriteLinesToFile File="$(DdiReferenceAssemblyListFile)" Lines="@(ReferencePath)" Overwrite="true" />
	  <Exec Command="dotnet &quot;$(DdiCodeGenToolExe)&quot; --yaml &quot;$(DdiInputYaml)&quot; --out &quot;$(MSBuildProjectDirectory)&quot; --refsFile &quot;$(DdiReferenceAssemblyListFile)&quot;" />
	  <!--
	    DDI codegen emits *.g.cs files into the project directory during the build.
	    SDK-style projects evaluate Compile globs before targets execute, so newly generated files
	    are not automatically picked up in the same build. Refresh the Compile item list here so
	    the just-generated files are included in CoreCompile.
	  -->
	  <ItemGroup>
	    <Compile Remove="$(MSBuildProjectDirectory)\**\*.g.cs" />
	    <Compile Include="$(MSBuildProjectDirectory)\**\*.g.cs" />
	  </ItemGroup>
	  <WriteLinesToFile File="$(DdiCodeGenStampFile)" Lines="Generated: $([System.DateTime]::UtcNow.ToString('o'))" Overwrite="true" />
	</Target>
</Project>
