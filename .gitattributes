# Enforce LF for shell scripts and GitHub workflow scripts
*.sh text eol=lf
.github/scripts/* text eol=lf

# Ensure YAML workflow files use LF
.github/workflows/*.yml text eol=lf
.github/workflows/*.yaml text eol=lf

# Normalize common text/code files to LF
*.cs            text eol=lf
*.csproj        text eol=lf
*.sln           text eol=lf
*.slnx          text eol=lf
*.props         text eol=lf
*.targets       text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.xml           text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.ps1           text eol=lf
*.psm1          text eol=lf
*.psd1          text eol=lf
*.sql           text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Keep binary files unchanged
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.zip           binary
*.dll           binary
*.exe           binary
*.pdb           binary